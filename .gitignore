# Dependencies
node_modules/

# npm pack artifacts — created by `npm pack` or `npm publish --dry-run`
*.tgz

# runn's own temp directories (created at runtime for React scaffolding)
.runn-temp/

# Manual test fixtures — run these with `runn fixtures/<file>` to smoke-test locally
# Not committed because they are dev-only scratch files, not part of the package
fixtures/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun.log

# Environment variables — never commit secrets
.env
.env.local
.env.*.local

# Test coverage output
coverage/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
